          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla seçmek için listede veya grafikte dosyalara ⌘ ile tıklayın, hepsini birlikte İnceleme Kuyruğuna ekleyin, ardından Tümünü Çöp Kutusu’na Taşı’yı kullanın. Her öğe taşınmadan hemen önce yeniden denetlenir."
          }
        }
      }
