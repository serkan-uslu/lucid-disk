    "File allocations are estimates. Shared APFS blocks can make their sum exceed disk capacity; this is not reclaimable space.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File allocations are estimates. Shared APFS blocks can make their sum exceed disk capacity; this is not reclaimable space."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyaların kapladığı alan tahminidir. Paylaşılan APFS blokları nedeniyle toplam disk kapasitesini aşabilir; bu değer boşaltılabilecek alan değildir."
          }
