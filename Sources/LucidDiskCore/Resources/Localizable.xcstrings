      }
    },
    "The measured file allocations exceed the space macOS reports as used. Shared APFS blocks and changes during scanning can contribute. This difference is not reclaimable space.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The measured file allocations exceed the space macOS reports as used. Shared APFS blocks and changes during scanning can contribute. This difference is not reclaimable space."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ölçülen dosya alanı, macOS’in bildirdiği kullanılan alanı aşıyor. Paylaşılan APFS blokları ve tarama sırasındaki değişiklikler buna katkıda bulunabilir. Bu fark boşaltılabilecek alan değildir."
          }
        }
