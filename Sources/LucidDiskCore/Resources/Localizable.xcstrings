        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli klasörün doğrudan içeriği; alt klasörlerin içeriği dahil edilmez."
          }
        }
      }
    },
    "Includes names, full paths, item types, sizes, dates and scan warnings. Parent folders are marked separately from matching results.": {
