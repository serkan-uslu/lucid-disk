      }
    },
    "Warnings include unreadable locations and intentionally skipped items. Full Disk Access may help with permission errors, but does not remove deliberate exclusions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warnings include unreadable locations and intentionally skipped items. Full Disk Access may help with permission errors, but does not remove deliberate exclusions."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyarılar, okunamayan konumları ve bilerek atlanan öğeleri kapsar. Tam Disk Erişimi izin hatalarında yardımcı olabilir; bilerek uygulanan dışlamaları kaldırmaz."
          }
        }
      }
    },
    "No scan warnings": {
