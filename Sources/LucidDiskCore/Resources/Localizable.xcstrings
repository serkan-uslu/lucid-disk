{
  "sourceLanguage": "en",
  "strings": {
    "How to Use": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to Use"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasıl Kullanılır"
          }
        }
      }
    },
    "Keyboard Shortcuts": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard Shortcuts"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavye Kısayolları"
          }
        }
      }
    },
    "Privacy & Safety": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy & Safety"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik ve Güvenlik"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakkında"
          }
        }
      }
    },
    "About Lucid Disk": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About Lucid Disk"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lucid Disk Hakkında"
          }
        }
      }
    },
    "Understand your space. Keep control.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Understand your space. Keep control."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alanınızı anlayın. Kontrol sizde kalsın."
          }
        }
      }
    },
    "Help topic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help topic"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yardım konusu"
          }
        }
      }
    },
    "Apache License 2.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apache License 2.0"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apache Lisansı 2.0"
          }
        }
      }
    },
    "From a full disk to a clear decision.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From a full disk to a clear decision."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolu bir diskten bilinçli bir karara."
          }
        }
      }
    },
    "Start with a folder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with a folder"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir klasörle başlayın"
          }
        }
      }
    },
    "Choose Folder is a good first scan. Explore Disk scans a mounted volume. Stop Scan cancels safely; your previous completed scan stays available.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Folder is a good first scan. Explore Disk scans a mounted volume. Stop Scan cancels safely; your previous completed scan stays available."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk tarama için Klasör Seç’i kullanın. Diski Keşfet, bağlı bir diski tarar. Taramayı Durdur güvenle iptal eder; tamamlanmış önceki taramanız korunur."
          }
        }
      }
    },
    "Explore the map": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore the map"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haritayı keşfedin"
          }
        }
      }
    },
    "On the chart, click a folder to enter it and the center to go back. In the file list, single-click to inspect and double-click a folder to open it. Other groups contain real, smaller items.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the chart, click a folder to enter it and the center to go back. In the file list, single-click to inspect and double-click a folder to open it. Other groups contain real, smaller items."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grafikte klasöre tıklayarak içine girin, merkeze tıklayarak geri dönün. Listede tek tıklama inceler, klasöre çift tıklama onu açar. Diğer grupları, gerçek küçük öğeleri içerir."
          }
        }
      }
    },
    "Understand before removing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Understand before removing"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silmeden önce anlayın"
          }
        }
      }
    },
    "Select a file for its size and safety notes. Press Space for Quick Look. Ask AI is optional: only that button requests a local explanation, based on metadata, not file contents.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a file for its size and safety notes. Press Space for Quick Look. Ask AI is optional: only that button requests a local explanation, based on metadata, not file contents."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boyut ve güvenlik notları için dosyayı seçin. Hızlı Bakış için Boşluk’a basın. AI’a Sor isteğe bağlıdır: yalnızca bu düğme, dosya içeriğini değil üst verileri kullanan yerel bir açıklama ister."
          }
        }
      }
    },
    "Review, then move to Trash": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review, then move to Trash"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnceleyin, sonra Çöp Kutusu’na taşıyın"
          }
        }
      }
    },
    "Add an item to the Review Queue. Select the queued item, choose Move to Trash, and confirm. Nothing is removed automatically. A new scan refreshes the list and clears the old queue.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an item to the Review Queue. Select the queued item, choose Move to Trash, and confirm. Nothing is removed automatically. A new scan refreshes the list and clears the old queue."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğeyi İnceleme Kuyruğu’na ekleyin. Kuyruktan seçip Çöp Kutusu’na Taşı’ya basın ve onaylayın. Hiçbir şey otomatik silinmez. Yeni tarama listeyi yeniler ve eski kuyruğu temizler."
          }
        }
      }
    },
    "Need a file back?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Need a file back?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir dosyayı geri mi istiyorsunuz?"
          }
        }
      }
    },
    "Open Trash in Finder and use Put Back where available. Lucid Disk never empties the Trash. Disk space is not necessarily freed until you empty it yourself.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Trash in Finder and use Put Back where available. Lucid Disk never empties the Trash. Disk space is not necessarily freed until you empty it yourself."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder’da Çöp Kutusu’nu açıp varsa Geri Koy’u kullanın. Lucid Disk, Çöp Kutusu’nu asla boşaltmaz. Siz boşaltana kadar disk alanı açılmayabilir."
          }
        }
      }
    },
    "Missing files or access warnings?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing files or access warnings?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksik dosyalar veya erişim uyarıları mı var?"
          }
        }
      }
    },
    "Some folders require Full Disk Access. You can enable Lucid Disk in System Settings → Privacy & Security → Full Disk Access, then scan again. This does not bypass all macOS protections.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some folders require Full Disk Access. You can enable Lucid Disk in System Settings → Privacy & Security → Full Disk Access, then scan again. This does not bypass all macOS protections."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı klasörler Tam Disk Erişimi gerektirir. Sistem Ayarları → Gizlilik ve Güvenlik → Tam Disk Erişimi’nde Lucid Disk’i etkinleştirip yeniden tarayabilirsiniz. Bu izin tüm macOS korumalarını aşmaz."
          }
        }
      }
    },
    "Open Privacy Settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Privacy Settings"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik Ayarlarını Aç"
          }
        }
      }
    },
    "A little less clicking.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A little less clicking."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha az tıklama."
          }
        }
      }
    },
    "Scan Again": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan Again"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden Tara"
          }
        }
      }
    },
    "Move between files": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move between files"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar arasında gezin"
          }
        }
      }
    },
    "Open selected folder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open selected folder"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili klasörü aç"
          }
        }
      }
    },
    "Close preview or help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close preview or help"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önizlemeyi veya yardımı kapat"
          }
        }
      }
    },
    "File navigation shortcuts apply while the file list is focused. Search covers the entire completed scan, including nested folders.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File navigation shortcuts apply while the file list is focused. Search covers the entire completed scan, including nested folders."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya gezinme kısayolları, liste odaktayken çalışır. Arama, iç içe klasörler dahil tamamlanmış taramanın tümünü kapsar."
          }
        }
      }
    },
    "Your files. Your decision.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your files. Your decision."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalarınız. Sizin kararınız."
          }
        }
      }
    },
    "Local by design": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local by design"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel çalışmak için tasarlandı"
          }
        }
      }
    },
    "Disk scans run on your Mac. There is no telemetry, analytics, or cloud AI fallback. Selecting a file does not invoke AI.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk scans run on your Mac. There is no telemetry, analytics, or cloud AI fallback. Selecting a file does not invoke AI."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk taramaları Mac’inizde çalışır. Telemetri, analitik veya bulut AI yedeği yoktur. Dosya seçmek AI’ı çalıştırmaz."
          }
        }
      }
    },
    "AI only when you ask": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI only when you ask"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI yalnızca siz istediğinizde"
          }
        }
      }
    },
    "Ask AI uses Apple’s on-device model when available. Otherwise, a rule-based explanation is shown. Neither reads file contents. AI cannot authorize deletion or lower a safety restriction.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask AI uses Apple’s on-device model when available. Otherwise, a rule-based explanation is shown. Neither reads file contents. AI cannot authorize deletion or lower a safety restriction."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI’a Sor, kullanılabiliyorsa Apple’ın cihaz içi modelini kullanır. Aksi halde kurallara dayalı açıklama gösterilir. İkisi de dosya içeriğini okumaz. AI, silme yetkisi veremez veya güvenlik kısıtlamasını azaltamaz."
          }
        }
      }
    },
    "Honest size estimates": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Honest size estimates"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şeffaf boyut tahminleri"
          }
        }
      }
    },
    "Allocated size is disk allocation; logical size is file length. Hard links are counted once. APFS clones may share blocks, so estimates are not a promise of reclaimable space. Incomplete scans are labeled.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allocated size is disk allocation; logical size is file length. Hard links are counted once. APFS clones may share blocks, so estimates are not a promise of reclaimable space. Incomplete scans are labeled."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrılan boyut diskte tahsis edilen alan, mantıksal boyut dosya uzunluğudur. Sabit bağlantılar bir kez sayılır. APFS klonları blokları paylaşabilir; tahminler açılacak alanın garantisi değildir. Eksik taramalar işaretlenir."
          }
        }
      }
    },
    "Protected removal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protected removal"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Korumalı silme"
          }
        }
      }
    },
    "Protected system locations are blocked. Before moving a reviewed item to Trash, Lucid Disk checks its identity and path again. Sensitive items require stronger confirmation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protected system locations are blocked. Before moving a reviewed item to Trash, Lucid Disk checks its identity and path again. Sensitive items require stronger confirmation."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Korunan sistem konumları engellenir. Lucid Disk, incelenen öğeyi Çöp Kutusu’na taşımadan önce kimliğini ve yolunu yeniden denetler. Hassas öğeler daha güçlü onay gerektirir."
          }
        }
      }
    },
    "MCP is separate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP is separate"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP ayrıdır"
          }
        }
      }
    },
    "The optional developer MCP server is not included in this app. Its read-only tools can expose metadata to the model you connect; review that client’s privacy settings before sharing anything.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The optional developer MCP server is not included in this app. Its read-only tools can expose metadata to the model you connect; review that client’s privacy settings before sharing anything."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı geliştirici MCP sunucusu bu uygulamaya dahil değildir. Salt okunur araçları, bağladığınız modele üst veri aktarabilir; paylaşmadan önce istemcinin gizlilik ayarlarını inceleyin."
          }
        }
      }
    },
    "A clearer view of your Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clearer view of your Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’inize daha net bir bakış."
          }
        }
      }
    },
    "An open-source disk explorer for understanding storage and reviewing what you choose to remove.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An open-source disk explorer for understanding storage and reviewing what you choose to remove."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depolamayı anlamak ve kaldırmayı seçtiğiniz dosyaları incelemek için açık kaynaklı bir disk gezgini."
          }
        }
      }
    },
    "Made by Serkan Uslu": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Made by Serkan Uslu"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serkan Uslu tarafından geliştirildi"
          }
        }
      }
    },
    "Built with Swift, SwiftUI and AppKit. Optional on-device explanations use Apple Foundation Models on supported Macs.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built with Swift, SwiftUI and AppKit. Optional on-device explanations use Apple Foundation Models on supported Macs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift, SwiftUI ve AppKit ile geliştirildi. İsteğe bağlı cihaz içi açıklamalar, desteklenen Mac’lerde Apple Foundation Models kullanır."
          }
        }
      }
    },
    "Open source · Apache 2.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source · Apache 2.0"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık kaynak · Apache 2.0"
          }
        }
      }
    },
    "You may use, study, modify and distribute Lucid Disk under the Apache License 2.0. The software is provided without warranties; review files and keep backups before removing anything.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may use, study, modify and distribute Lucid Disk under the Apache License 2.0. The software is provided without warranties; review files and keep backups before removing anything."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lucid Disk’i Apache Lisansı 2.0 kapsamında kullanabilir, inceleyebilir, değiştirebilir ve dağıtabilirsiniz. Yazılım garanti verilmeden sunulur; silmeden önce dosyaları inceleyin ve yedek alın."
          }
        }
      }
    },
    "Read License": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read License"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisansı Oku"
          }
        }
      }
    },
    "Development build": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Development build"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geliştirme derlemesi"
          }
        }
      }
    },
    "Version %@ (%@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@ (%@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürüm %@ (%@)"
          }
        }
      }
    },
    "The license is included in packaged builds and in the source repository’s LICENSE file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The license is included in packaged builds and in the source repository’s LICENSE file."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisans, uygulama paketlerinde ve kaynak deponun LICENSE dosyasında bulunur."
          }
        }
      }
    },
    "Moving to Trash…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving to Trash…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp Kutusu’na taşınıyor…"
          }
        }
      }
    },
    "Moved %@ to Trash. You can restore it from Finder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moved %@ to Trash. You can restore it from Finder."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Çöp Kutusu’na taşındı. Finder’dan geri yükleyebilirsiniz."
          }
        }
      }
    },
    "Show in Trash": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show in Trash"
          }
