            "state": "translated",
            "value": "Aynı anda birden fazla öğe"
          }
        }
      }
    },
    "⌘-click files in the list or the chart to select several, add them to the Review Queue together, then use Move All to Trash. Every item is checked again just before it moves.": {
      "localizations": {
        "en": {
          "stringUnit": {
