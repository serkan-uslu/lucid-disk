      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built with Swift, SwiftUI and AppKit. Optional explanations use Apple Foundation Models, a local Ollama model, or the Claude API — your choice in Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift, SwiftUI ve AppKit ile geliştirildi. İsteğe bağlı açıklamalar Apple Foundation Models, yerel bir Ollama modeli veya Claude API ile yapılır; seçim Ayarlar’da sizde."
          }
        }
      }
    },
