          }
        }
      }
    },
    "Ask AI shows Lucid Disk’s deterministic explanation: matched safety rule, size, type, dates and associated app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask AI shows Lucid Disk’s deterministic explanation: matched safety rule, size, type, dates and associated app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask AI, Lucid Disk’in kural tabanlı açıklamasını gösterir: eşleşen güvenlik kuralı, boyut, tür, tarihler ve ilişkili uygulama."
          }
        }
      }
    },
    "Ask AI uses the provider chosen in Settings: Apple’s on-device model (default), a local Ollama model, the Claude API, or rules only. No provider reads file contents. If a provider fails, the rule-based explanation is shown; Lucid Disk never switches to another provider on its own. AI cannot authorize deletion or lower a safety restriction.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask AI uses the provider chosen in Settings: Apple’s on-device model (default), a local Ollama model, the Claude API, or rules only. No provider reads file contents. If a provider fails, the rule-based explanation is shown; Lucid Disk never switches to another provider on its own. AI cannot authorize deletion or lower a safety restriction."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask AI, Ayarlar’da seçilen sağlayıcıyı kullanır: Apple’ın cihaz içi modeli (varsayılan), yerel bir Ollama modeli, Claude API veya yalnızca kurallar. Hiçbir sağlayıcı dosya içeriğini okumaz. Bir sağlayıcı başarısız olursa kural tabanlı açıklama gösterilir; Lucid Disk kendiliğinden başka bir sağlayıcıya geçmez. AI silmeye izin veremez veya bir güvenlik kısıtlamasını gevşetemez."
          }
        }
      }
    },
    "Available on this Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available on this Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac’te kullanılabilir."
          }
        }
      }
    },
