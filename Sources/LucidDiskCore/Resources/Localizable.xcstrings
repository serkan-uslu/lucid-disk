    "Disk totals for %@, compared with the root scan at %@. These figures keep the whole-disk scope when you open a folder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk totals for %@, compared with the root scan at %@. These figures keep the whole-disk scope when you open a folder."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ disk toplamlarının %@ kök taramasıyla karşılaştırması. Bir klasörü açtığınızda bu değerler diskin tamamını kapsamaya devam eder."
          }
        }
      }
    },
    "Show All Warnings (%lld)": {
