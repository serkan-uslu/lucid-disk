          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift, SwiftUI ve AppKit ile geliştirildi. İsteğe bağlı açıklamalar Apple Foundation Models, yerel bir Ollama modeli veya Claude API ile yapılır; seçim Ayarlar’da sizde."
          }
        }
      }
    },
